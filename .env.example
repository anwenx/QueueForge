# Copy to .env (never commit .env). All values optional except QF_API_KEYS in production.
NODE_ENV=production
QF_HOST=0.0.0.0
QF_PORT=8080
QF_DB_PATH=/data/queueforge.db
# Comma-separated "name:key" pairs. Keys must be >= 16 chars. Generate: openssl rand -hex 24
QF_API_KEYS=admin:change-me-to-a-long-random-string
QF_LOG_LEVEL=info
QF_LEASE_MS=30000
QF_BACKOFF_BASE_MS=1000
QF_BACKOFF_MAX_MS=300000
QF_DEFAULT_MAX_ATTEMPTS=5
QF_REAPER_MS=5000
QF_RATE_LIMIT_PER_SEC=50
QF_RATE_LIMIT_BURST=100
QF_MAX_BODY_BYTES=131072
QF_WORKER_CONCURRENCY=4
