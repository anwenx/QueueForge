{
  "name": "queueforge",
  "version": "1.0.0",
  "description": "A durable, SQLite-backed job queue with leases, retries, dead-lettering, HTTP API, worker runtime and dashboard. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "bin": { "queueforge": "bin/queueforge.js" },
  "scripts": {
    "start": "node bin/queueforge.js serve --with-worker",
    "serve": "node bin/queueforge.js serve",
    "worker": "node bin/queueforge.js worker",
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "ci": "npm run check && npm test"
  }
}
